{
  "name": "jokko-business-back",
  "version": "1.0.0",
  "description": "Backend de Jokko Business - Gestion commerciale SaaS",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "RUN ON DEVELOPMENT": "LOCAL SCRIPT",
    "dev": " cross-env NODE_ENV=development tsx   watch src/index.ts",
    "dev:noEmit": "tsc --noEmit  --watch",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "postinstall": " dotenv -e .env.development.local prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "dotenv -e .env.development.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.development.local prisma studio",
    "seed:db": "dotenv -e .env.development.local tsx src/scripts/index.ts",
    "db:reset": "dotenv -e .env.development.local prisma migrate reset",
    "deploy:local": "npx dotenv-cli -e .env.production.local -- npx prisma migrate deploy",
    "db:status": "npx dotenv-cli -e .env.production.local -- npx prisma migrate status",
    "RUN ON PRODUCTION": "PRODUCTION SCRIPT",
    "prod:build": "cross-env NODE_ENV=production tsc -- npx prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/engines": "^7.10.0",
    "@supabase/supabase-js": "^2.112.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.19",
    "@types/streamifier": "^0.1.2",
    "bcrypt": "^5.1.1",
    "body-parser": "^2.3.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.2",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "streamifier": "^0.1.1",
    "typescript": "^5.9.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.1"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}